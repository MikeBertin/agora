{"scenarios":[{"id":"clear","label":"A clear match","blurb":"Everyone agrees on how the other side ranks, so the market is assortative. There is exactly one stable matching, so it makes no difference who proposes: watch the same rejection cascade sort everyone into place from either side. The interesting cases are the others.","sides":{"a":{"label":"Candidates","agents":["Ana","Ben","Cleo"],"prefs":{"Ana":["Koru","Lumen","Onyx"],"Ben":["Koru","Lumen","Onyx"],"Cleo":["Koru","Lumen","Onyx"]},"caps":{"Ana":1,"Ben":1,"Cleo":1}},"b":{"label":"Companies","agents":["Koru","Lumen","Onyx"],"prefs":{"Koru":["Ana","Ben","Cleo"],"Lumen":["Ana","Ben","Cleo"],"Onyx":["Ana","Ben","Cleo"]},"caps":{"Koru":1,"Lumen":1,"Onyx":1}}},"runs":{"a":{"proposing":"a","rounds":3,"proposals":6,"frames":[{"round":1,"proposals":[["Ana","Koru"],["Ben","Koru"],["Cleo","Koru"]],"accepted":[["Ana","Koru"]],"rejected":[["Ben","Koru"],["Cleo","Koru"]],"bumped":[],"engaged":[["Ana","Koru"]]},{"round":2,"proposals":[["Ben","Lumen"],["Cleo","Lumen"]],"accepted":[["Ben","Lumen"]],"rejected":[["Cleo","Lumen"]],"bumped":[],"engaged":[["Ana","Koru"],["Ben","Lumen"]]},{"round":3,"proposals":[["Cleo","Onyx"]],"accepted":[["Cleo","Onyx"]],"rejected":[],"bumped":[],"engaged":[["Ana","Koru"],["Ben","Lumen"],["Cleo","Onyx"]]}],"matchA":{"Ana":["Koru"],"Ben":["Lumen"],"Cleo":["Onyx"]},"matchB":{"Koru":["Ana"],"Lumen":["Ben"],"Onyx":["Cleo"]},"rankA":{"Ana":[1],"Ben":[2],"Cleo":[3]},"rankB":{"Koru":[1],"Lumen":[2],"Onyx":[3]},"avgRankA":2.0,"avgRankB":2.0,"unmatchedA":[],"unmatchedB":[]},"b":{"proposing":"b","rounds":3,"proposals":6,"frames":[{"round":1,"proposals":[["Ana","Koru"],["Ana","Lumen"],["Ana","Onyx"]],"accepted":[["Ana","Koru"]],"rejected":[["Ana","Lumen"],["Ana","Onyx"]],"bumped":[],"engaged":[["Ana","Koru"]]},{"round":2,"proposals":[["Ben","Lumen"],["Ben","Onyx"]],"accepted":[["Ben","Lumen"]],"rejected":[["Ben","Onyx"]],"bumped":[],"engaged":[["Ana","Koru"],["Ben","Lumen"]]},{"round":3,"proposals":[["Cleo","Onyx"]],"accepted":[["Cleo","Onyx"]],"rejected":[],"bumped":[],"engaged":[["Ana","Koru"],["Ben","Lumen"],["Cleo","Onyx"]]}],"matchA":{"Ana":["Koru"],"Ben":["Lumen"],"Cleo":["Onyx"]},"matchB":{"Koru":["Ana"],"Lumen":["Ben"],"Onyx":["Cleo"]},"rankA":{"Ana":[1],"Ben":[2],"Cleo":[3]},"rankB":{"Koru":[1],"Lumen":[2],"Onyx":[3]},"avgRankA":2.0,"avgRankB":2.0,"unmatchedA":[],"unmatchedB":[]}},"stable":{"count":1,"matchings":[{"Ana":"Koru","Ben":"Lumen","Cleo":"Onyx"}]}},{"id":"chain","label":"The domino effect","blurb":"Five candidates, four jobs. Ana loses Koru to Eve, so she takes Lumen from Ben; Ben takes Onyx from Cleo; Cleo takes Pico from Dex, and Dex, bumped last, ends with nothing. Engagements are only ever tentative: one rejection can reshuffle everyone downstream, which is exactly why the algorithm defers acceptance until the market goes quiet.","sides":{"a":{"label":"Candidates","agents":["Ana","Ben","Cleo","Dex","Eve"],"prefs":{"Ana":["Koru","Lumen"],"Ben":["Lumen","Onyx"],"Cleo":["Onyx","Pico"],"Dex":["Pico","Koru"],"Eve":["Koru","Lumen"]},"caps":{"Ana":1,"Ben":1,"Cleo":1,"Dex":1,"Eve":1}},"b":{"label":"Companies","agents":["Koru","Lumen","Onyx","Pico"],"prefs":{"Koru":["Eve","Ana","Dex"],"Lumen":["Ana","Ben","Eve"],"Onyx":["Ben","Cleo"],"Pico":["Cleo","Dex"]},"caps":{"Koru":1,"Lumen":1,"Onyx":1,"Pico":1}}},"runs":{"a":{"proposing":"a","rounds":5,"proposals":9,"frames":[{"round":1,"proposals":[["Ana","Koru"],["Ben","Lumen"],["Cleo","Onyx"],["Dex","Pico"],["Eve","Koru"]],"accepted":[["Eve","Koru"],["Ben","Lumen"],["Cleo","Onyx"],["Dex","Pico"]],"rejected":[["Ana","Koru"]],"bumped":[],"engaged":[["Eve","Koru"],["Ben","Lumen"],["Cleo","Onyx"],["Dex","Pico"]]},{"round":2,"proposals":[["Ana","Lumen"]],"accepted":[["Ana","Lumen"]],"rejected":[],"bumped":[["Ben","Lumen"]],"engaged":[["Eve","Koru"],["Ana","Lumen"],["Cleo","Onyx"],["Dex","Pico"]]},{"round":3,"proposals":[["Ben","Onyx"]],"accepted":[["Ben","Onyx"]],"rejected":[],"bumped":[["Cleo","Onyx"]],"engaged":