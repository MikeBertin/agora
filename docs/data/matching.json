,"Lumen","Onyx"],"Ben":["Lumen","Onyx","Koru"],"Cleo":["Onyx","Koru","Lumen"]},"caps":{"Ana":1,"Ben":1,"Cleo":1}},"b":{"label":"Companies","agents":["Koru","Lumen","Onyx"],"prefs":{"Koru":["Ben","Cleo","Ana"],"Lumen":["Cleo","Ana","Ben"],"Onyx":["Ana","Ben","Cleo"]},"caps":{"Koru":1,"Lumen":1,"Onyx":1}}},"runs":{"a":{"proposing":"a","rounds":1,"proposals":3,"frames":[{"round":1,"proposals":[["Ana","Koru"],["Ben","Lumen"],["Cleo","Onyx"]],"accepted":[["Ana","Koru"],["Ben","Lumen"],["Cleo","Onyx"]],"rejected":[],"bumped":[],"engaged":[["Ana","Koru"],["Ben","Lumen"],["Cleo","Onyx"]]}],"matchA":{"Ana":["Koru"],"Ben":["Lumen"],"Cleo":["Onyx"]},"matchB":{"Koru":["Ana"],"Lumen":["Ben"],"Onyx":["Cleo"]},"rankA":{"Ana":[1],"Ben":[1],"Cleo":[1]},"rankB":{"Koru":[3],"Lumen":[3],"Onyx":[3]},"avgRankA":1.0,"avgRankB":3.0,"unmatchedA":[],"unmatchedB":[]},"b":{"proposing":"b","rounds":1,"proposals":3,"frames":[{"round":1,"proposals":[["Ben","Koru"],["Cleo","Lumen"],["Ana","Onyx"]],"accepted":[["Ben","Koru"],["Cleo","Lumen"],["Ana","Onyx"]],"rejected":[],"bumped":[],"engaged":[["Ana","Onyx"],["Ben","Koru"],["Cleo","Lumen"]]}],"matchA":{"Ana":["Onyx"],"Ben":["Koru"],"Cleo":["Lumen"]},"matchB":{"Koru":["Ben"],"Lumen":["Cleo"],"Onyx":["Ana"]},"rankA":{"Ana":[3],"Ben":[3],"Cleo":[3]},"rankB":{"Koru":[1],"Lumen":[1],"Onyx":[1]},"avgRankA":3.0,"avgRankB":1.0,"unmatchedA":[],"unmatchedB":[]}},"stable":{"count":3,"matchings":[{"Ana":"Koru","Ben":"Lumen","Cleo":"Onyx"},{"Ana":"Lumen","Ben":"Onyx","Cleo":"Koru"},{"Ana":"Onyx","Ben":"Koru","Cleo":"Lumen"}]}},{"id":"strategy","label":"The profitable lie","blurb":"With candidates proposing, no candidate can ever gain by misreporting; we brute-force every list they could submit. But Koru can: by striking Ana off its list entirely, the rejection ricochets around the market and delivers Koru its first choice, Ben. Strategy-proofness only ever holds for the proposing side.","sides":{"a":{"label":"Candidates","agents":["Ana","Ben"],"prefs":{"Ana":["